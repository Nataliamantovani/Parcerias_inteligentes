# Copie para .env (que NÃO vai para o GitHub) e preencha só no servidor.
# Nunca use o prefixo VITE_ para estas variáveis: ele as enviaria ao navegador.

# Módulo Habilitação e Regularidade -------------------------------------------
# Trava de segurança. Mantenha "false" em qualquer ambiente público sem login.
HABILITACAO_CONSULTAS_ATIVAS=false

# Chave pessoal da API de Dados do Portal da Transparência (CGU).
# Obtenha em https://portaldatransparencia.gov.br/api-de-dados/cadastrar-email
PORTAL_TRANSPARENCIA_API_KEY=

# Opcional: endereço da API (padrão: https://api.portaldatransparencia.gov.br/api-de-dados)
PORTAL_TRANSPARENCIA_API_URL=
